{
  "design_version": "v0.3.15",
  "design_section": "10.2",
  "arxiv_categories": [
    "cs.LG",
    "cs.AI",
    "cs.CV",
    "cs.CL",
    "stat.ML"
  ],
  "timepoints": {
    "T1": {
      "role": "train",
      "build": [
        2014,
        2018
      ],
      "buffer": [
        2019,
        2019
      ],
      "label": [
        2020,
        2021
      ]
    },
    "T2": {
      "role": "evaluate",
      "build": [
        2017,
        2021
      ],
      "buffer": [
        2022,
        2022
      ],
      "label": [
        2023,
        2024
      ]
    }
  },
  "applied": {
    "build_years": 5,
    "anchor": "data_cutoff",
    "prescription": {
      "redundancy_rules": [
        "D1_same_name_ignoring_spaces",
        "D2_method_name_within_task_name",
        "D3_same_type_text_cosine"
      ],
      "d3_same_type_cosine_quantile": 0.985,
      "training": "T1+T2 labels, feature sets by V2 verdict, trees by stratified CV on the combined set",
      "calibration": "none (ranking only; expected hit rate is the T2 Precision@k of the engine used)"
    }
  },
  "vocab": {
    "r4_wordlist": "/usr/share/dict/words",
    "r3_min_acronym_len": 3,
    "restore_min_support": 2,
    "r5_rule": {
      "method": "resampling_stability_with_matching_noise",
      "stability": 0.95,
      "precision": "m1_stratum_wilson_lower_95"
    },
    "r6_rule": {
      "method": "chung_lu_validity",
      "paper_degree_quantile": 0.99
    },
    "m1_fix": {
      "junk_pattern": "[<>\"{}\\[\\]|\\\\`]",
      "r3_exclude": [
        {
          "term_id": "M:linear discriminant analysis",
          "surface": "LDA"
        },
        {
          "term_id": "M:energy based model",
          "surface": "EBM"
        },
        {
          "term_id": "M:slime mould algorithm",
          "surface": "SMA"
        },
        {
          "term_id": "M:conditional random field",
          "surface": "CRF"
        },
        {
          "term_id": "M:diffusion convolutional neural networks",
          "surface": "DCNN"
        },
        {
          "term_id": "M:semantic cross attention",
          "surface": "SCA"
        },
        {
          "term_id": "M:switchable atrous convolution",
          "surface": "SAC"
        },
        {
          "term_id": "M:g3d",
          "surface": "G3D"
        },
        {
          "term_id": "M:region proposal network",
          "surface": "RPN"
        },
        {
          "term_id": "M:approximate bayesian computation",
          "surface": "ABC"
        },
        {
          "term_id": "M:masked autoencoder",
          "surface": "MAE"
        }
      ]
    }
  },
  "r4_review": {
    "seed": 20261002,
    "n_per_stratum": 3,
    "allow_threshold": 0.6
  },
  "quality": {
    "m1": {
      "seed": 20261003,
      "n_per_stratum": 100,
      "strata": [
        "method_ci",
        "task_ci",
        "acronym_cs"
      ],
      "pass_rule": {
        "statistic": "wilson_lower_95",
        "pass": 0.8,
        "conditional": 0.75
      },
      "max_remeasure": 2
    },
    "m2": {
      "seed": 20261004,
      "n_per_category": 100,
      "categories": [
        "company",
        "academic",
        "government",
        "individual"
      ],
      "pass_rule": {
        "statistic": "wilson_lower_95",
        "pass": 0.8,
        "conditional": 0.75
      },
      "max_remeasure": 2
    },
    "q1": {
      "seed": 20261005,
      "n_sentences": 100
    }
  },
  "secondary_analyses": {
    "S1": {
      "description": "V1 and V2 recomputed with all case-sensitive acronym surfaces removed",
      "drop_match_modes": [
        "cs"
      ]
    }
  },
  "candidates": {
    "pair_rule": "pair_stability_with_r5_stability",
    "two_hop": {
      "score": "adamic_adar_missing_pair",
      "tie_break": [
        "weakest_pair_count",
        "triad_id"
      ],
      "n_ratio_to_open_triangles": 1.0
    },
    "coherence": "exclude_all_task_triads"
  },
  "labels": {
    "null_model": "chung_lu_triadic",
    "probability_cap": 1.0,
    "test": "poisson_binomial_upper_tail_exact_by_degree",
    "correction": "benjamini_hochberg",
    "fdr": 0.05,
    "scope": "all candidates of the timepoint"
  },
  "features": {
    "recent_years": 2,
    "text": {
      "min_df": 5,
      "max_df": 0.5,
      "max_features": 50000,
      "svd_dims": 100,
      "seed": 20261004
    },
    "sets": {
      "P": [
        "P_aa_min",
        "P_aa_mean",
        "P_aa_gmean",
        "P_cn_min",
        "P_cn_mean",
        "P_cn_gmean",
        "P_npmi_min",
        "P_npmi_mean",
        "P_npmi_max",
        "P_logfreq_min",
        "P_logfreq_mean"
      ],
      "H": [
        "H_pairedges_min",
        "H_pairedges_mean",
        "H_pairedges_gmean",
        "H_triad_cn",
        "H_size_weighted_aa",
        "H_related_edge_size_mean",
        "H_open_triangle"
      ],
      "T": [
        "T_cos_mean",
        "T_cos_min",
        "T_volume"
      ],
      "R": [
        "R_growth_min",
        "R_growth_mean"
      ]
    }
  },
  "model": {
    "type": "lightgbm_binary",
    "params": {
      "num_leaves": 7,
      "min_data_in_leaf": 20,
      "learning_rate": 0.05,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0
    },
    "n_estimators_max": 2000,
    "early_stopping_rounds": 100,
    "cv_folds": 5,
    "cv_metric": "average_precision",
    "seeds": [
      20261011,
      20261012,
      20261013,
      20261014,
      20261015
    ],
    "engine_sets": [
      "P",
      "H",
      "T",
      "R"
    ],
    "v2_baseline_sets": [
      "P",
      "T",
      "R"
    ]
  },
  "evaluation": {
    "top_k": 100,
    "secondary_k": [
      50,
      500
    ],
    "bootstrap_n": 1000,
    "bootstrap_seed": 20261016,
    "ci_level": 0.95,
    "rule": "pass only if both candidate and term-block bootstrap lower bounds exceed the threshold",
    "score": "mean predicted probability over model seeds"
  }
}